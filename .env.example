# https://github.com/settings/tokens?type=beta
GH_ACCESS_TOKEN=
# Optional: base URL for image URLs in the backgrounds catalogue.
# Defaults to the Vercel production or deployment URL, or http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Optional: the Ollama server and model behind the blurb generator in the admin.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Optional: an Unsplash API access key, so the admin can add photos from pasted Unsplash links.
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
# Feedback form. Create the table with supabase/feedback.sql.
# The publishable key can only insert feedback (RLS); keep it server-side anyway so the
# honeypot and rate limit stay in front of it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The secret key bypasses RLS and reads the feedback: server-only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# The responses page lives at /the-complaints-department/<FEEDBACK_ADMIN_KEY>, behind
# Basic auth (any username, this password). Use long random values for both.
FEEDBACK_ADMIN_KEY=
FEEDBACK_ADMIN_PASSWORD=
# Vercel sends this as a bearer token to the daily digest cron.
CRON_SECRET=
# The daily digest email, sent through Resend. FEEDBACK_EMAIL_FROM is optional and
# needs a verified domain; the default only delivers to your own Resend account email.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
FEEDBACK_EMAIL_FROM=
